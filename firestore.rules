rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /trees/{treeId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.role != 'viewer';
      allow create: if request.auth != null;
      allow delete: if false;
    }
    match /trees/{treeId}/members/{uid} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.role == 'owner';
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.role == 'owner' &&
        uid != request.auth.uid;
    }
    match /trees/{treeId}/activity/{logId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid));
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid));
      allow update, delete: if false;
    }
    match /trees/{treeId}/moments/{momentId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid));
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)) &&
        request.resource.data.byUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.byUid == request.auth.uid ||
         get(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.role == 'owner');
      allow update: if false;
    }
  }
}
