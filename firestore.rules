rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // Identity vs. permission
    //
    // Authority for "is this user a member / what role?" is the member
    // document at trees/{treeId}/members/{uid} -- a document the user can
    // NEVER freely create for themselves in an existing tree.
    //
    // It is deliberately NOT users/{uid}: that doc IS self-writable, so
    // basing permission on it lets a user grant themselves any role.
    // ===================================================================

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberDoc(treeId) {
      return /databases/$(database)/documents/trees/$(treeId)/members/$(uid());
    }
    function isMember(treeId) { return signedIn() && exists(memberDoc(treeId)); }
    function myRole(treeId) { return get(memberDoc(treeId)).data.role; }
    function isOwner(treeId) { return isMember(treeId) && myRole(treeId) == 'owner'; }
    function canEdit(treeId) { return isMember(treeId) && myRole(treeId) != 'viewer'; }
    function treeCreatedBy(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data.createdBy;
    }
    function inviteDoc(treeId, token) {
      return /databases/$(database)/documents/trees/$(treeId)/invites/$(token);
    }
    function linkRequestDoc(treeId, token) {
      return /databases/$(database)/documents/trees/$(treeId)/linkRequests/$(token);
    }
    function viewerDoc(treeId, user) {
      return /databases/$(database)/documents/trees/$(treeId)/viewers/$(user);
    }
    // A link grants cross-tree READ via a uid-keyed viewer doc (not membership).
    function canViewTree(treeId) {
      return isMember(treeId) || (signedIn() && exists(viewerDoc(treeId, uid())));
    }

    // users/{uid}: self only. Never a source of permission.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      // Self-written index of the trees this user belongs to (role + cached
      // familyName for display). NOT authority — trees/{t}/members/{uid} is.
      // A user can only ever touch their OWN memberships.
      match /memberships/{treeId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /trees/{treeId} {
      allow read:   if canViewTree(treeId);   // members, or a cross-tree linked viewer (read-only)
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      // createdBy is immutable on update: an editor could otherwise rewrite it
      // to a throwaway uid that then satisfies the bootstrap owner path (C1).
      allow update: if canEdit(treeId)
                    && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isMember(treeId);

        // create — three legitimate paths, never free self-grant:
        allow create: if signedIn() && (
          // (1) bootstrap: the tree's creator becomes its first owner
          ( memberUid == uid()
            && request.resource.data.role == 'owner'
            && treeCreatedBy(treeId) == uid()
            && !exists(memberDoc(treeId)) )
          ||
          // (2) invited join: a valid invite exists; role must match it and never be owner
          ( memberUid == uid()
            && request.resource.data.role != 'owner'
            && exists(inviteDoc(treeId, request.resource.data.viaInvite))
            && get(inviteDoc(treeId, request.resource.data.viaInvite)).data.role
                 == request.resource.data.role )
          ||
          // (3) an owner adds someone directly — but never a SECOND owner
          //     (one-owner-per-tree invariant; transfer is out of Phase 0 scope)
          ( isOwner(treeId)
            && request.resource.data.role in ['editor', 'viewer'] )
        );

        allow update: if isOwner(treeId);
        allow delete: if isOwner(treeId) && memberUid != uid();
      }

      match /invites/{token} {
        allow get:    if signedIn();          // a joiner reads the token they were handed
        allow list:   if isMember(treeId);    // only members may enumerate invites
        allow create: if canEdit(treeId)
                      && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if canEdit(treeId);
        allow update: if false;
      }

      match /activity/{logId} {
        allow read:   if isMember(treeId);
        allow create: if isMember(treeId);
        allow update, delete: if false;
      }

      match /moments/{momentId} {
        allow read:   if isMember(treeId);
        allow create: if isMember(treeId) && request.resource.data.byUid == uid();
        allow delete: if signedIn() &&
                      (resource.data.byUid == uid() || isOwner(treeId));
        allow update: if false;

        // A reaction is one document per member, keyed by the reactor's uid, so
        // a member can only ever write or remove their OWN reaction — no way to
        // forge or clear someone else's. Any member may read all reactions.
        match /reactions/{reactorUid} {
          allow read:          if isMember(treeId);
          allow create, update: if isMember(treeId) && reactorUid == uid()
                               && request.resource.data.byUid == uid();
          allow delete:        if isMember(treeId) && reactorUid == uid();
        }

        // Comments: any member may add one carrying their own byUid; the author
        // or the tree owner may delete; never editable (same integrity stance as
        // moments themselves — history is not silently rewritten).
        match /comments/{commentId} {
          allow read:   if isMember(treeId);
          allow create: if isMember(treeId) && request.resource.data.byUid == uid();
          allow delete: if signedIn() &&
                        (resource.data.byUid == uid() || isOwner(treeId));
          allow update: if false;
        }
      }

      // Photos: each person/moment photo is its own document (base64 in `data`),
      // kept out of the single tree doc so it never hits the 1MB limit. Any member
      // reads; only non-viewer members (editors/owner) write/replace/delete — the
      // same authority as the tree itself. Firestore's 1MB doc cap bounds size.
      match /photos/{photoId} {
        allow read:          if canViewTree(treeId);   // profile photos are part of the revealed tree
        allow create, update: if canEdit(treeId);
        allow delete:        if canEdit(treeId);
      }

      // Family link protocol (project 2). A pending link request is minted by the
      // owner of THIS tree and shared out-of-band as a token (same trust model as
      // invites). The mirrored `links` docs are written on both trees at approval:
      // the approver writes their own copy by ownership, and the requester's copy
      // is authorised ONLY by a matching pending request in that tree. A link
      // grants `view_tree` and nothing more — never write, never a member doc.
      match /linkRequests/{token} {
        allow get:    if signedIn();                 // approver reads the request by token
        allow list:   if isOwner(treeId);            // only the owner enumerates their requests
        allow create: if isOwner(treeId) && request.resource.data.kind == 'same_person';
        allow delete: if isOwner(treeId);            // owner cancels a pending request
        allow update: if false;
      }

      match /links/{linkId} {
        allow read:   if isMember(treeId);
        allow create: if signedIn()
                      && request.resource.data.kind == 'same_person'
                      && request.resource.data.status == 'accepted'
                      && request.resource.data.grantedScope == 'view_tree'
                      && (
                        // (a) this tree's owner writes their own mirror copy
                        isOwner(treeId)
                        ||
                        // (b) an external approver writes THIS tree's copy, authorised
                        //     by a matching pending request that its owner minted here
                        ( exists(linkRequestDoc(treeId, request.resource.data.viaRequest))
                          && get(linkRequestDoc(treeId, request.resource.data.viaRequest)).data.localPersonId
                               == request.resource.data.localPersonId )
                      );
        allow delete: if isOwner(treeId);            // any owner revokes their own copy
        allow update: if false;                      // immutable; revoke = delete
      }

      // Cross-tree read grant (project 3a). A uid-keyed doc: its existence lets the
      // named user READ this tree (canViewTree). Created by the tree owner, or by a
      // user granting THEMSELVES via a matching pending link request (same token
      // trust model as the link doc). Revocable by that viewer OR the tree owner —
      // mutual sovereignty. Never grants write (the viewer is not a member).
      match /viewers/{viewerUid} {
        allow get:    if isMember(treeId) || viewerUid == uid();
        allow list:   if isOwner(treeId);
        allow create: if signedIn() && (
                        isOwner(treeId)
                        || ( viewerUid == uid()
                             && exists(linkRequestDoc(treeId, request.resource.data.viaRequest)) )
                      );
        allow delete: if isOwner(treeId) || viewerUid == uid();
        allow update: if false;
      }
    }
  }
}
