rules_version = '2';

// Photos live at trees/{treeId}/{people|moments}/{fileName}. Access mirrors the
// Firestore multi-tenant model: authority is the member doc at
// trees/{treeId}/members/{uid} (read here via firestore.get/exists) — NEVER
// users/{uid}. Any member may read; only non-viewer members (editors/owner) may
// write or delete. Writes are limited to small images so the bucket can't be
// abused. Cross-tree read (for family federation) is intentionally NOT here yet.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    function memberDoc(treeId) {
      return firestore.get(/databases/(default)/documents/trees/$(treeId)/members/$(request.auth.uid));
    }
    function isMember(treeId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/trees/$(treeId)/members/$(request.auth.uid));
    }
    function canEdit(treeId) {
      return isMember(treeId) && memberDoc(treeId).data.role != 'viewer';
    }

    // `sub` is constrained to the two known photo folders; raster image types
    // only (svg+xml can carry script, so it is excluded even though bytes aren't
    // validated). Reads are member-only; writes/deletes are non-viewer members.
    match /trees/{treeId}/{sub}/{fileName} {
      allow read:   if isMember(treeId) && sub in ['people', 'moments'];
      allow write:  if canEdit(treeId)
                    && sub in ['people', 'moments']
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if canEdit(treeId) && sub in ['people', 'moments'];
    }

    // Everything outside the per-tree photo tree is denied by default.
  }
}
